{%- comment -%}Resumen de errores devuelto por Shopify. Parámetros: form, uid.{%- endcomment -%}
{%- if form.errors -%}
  <div class="sd-notice sd-notice--error sd-form-errors" role="alert" tabindex="-1" data-sd-form-errors>
    {%- render 'icon', name: 'alert', size: 22 -%}
    <div>
      <p class="sd-notice__title">{{ 'forms.error_title' | t }}</p>
      <ul>
        {%- for field in form.errors -%}
          <li>
            {%- if field == 'form' -%}
              {{ form.errors.messages[field] }}
            {%- else -%}
              <a href="#{{ uid }}-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}
