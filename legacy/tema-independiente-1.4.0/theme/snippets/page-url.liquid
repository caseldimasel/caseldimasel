{%- comment -%}
  URL de una página clave del tema, sin llegar nunca a un 404 en una tienda recién instalada.
  Parámetros: key = sell | how | about | favorites | contact | archive | wanted | brands | explore | search
              out = url (por defecto) | exists (devuelve true si la página/colección existe de verdad)
  Orden: página elegida en Ajustes del tema > Páginas clave → página de Shopify con el handle de reserva →
  ancla dentro de la portada (la portada incluye esos bloques) o ruta que siempre existe.
{%- endcomment -%}
{%- liquid
  assign p = nil
  assign handle = ''
  assign anchor = ''
  assign fallback = routes.root_url
  case key
    when 'sell'
      assign p = settings.page_sell
      assign handle = 'vender'
      assign anchor = '#solicitud'
    when 'how'
      assign p = settings.page_how
      assign handle = 'como-vendemos'
      assign anchor = '#como'
    when 'about'
      assign p = settings.page_about
      assign handle = 'sobre-sidonia'
      assign anchor = '#criterio'
    when 'favorites'
      assign p = settings.page_favorites
      assign handle = 'favoritos'
      assign anchor = '#favoritos'
    when 'contact'
      assign p = settings.page_contact
      assign handle = 'contacto'
      assign anchor = '#contacto'
    when 'archive'
      assign p = settings.page_archive
      assign handle = 'archivo'
      assign fallback = routes.all_products_collection_url
    when 'wanted'
      assign p = settings.page_wanted
      assign handle = 'busco'
      assign anchor = '#contacto'
    when 'brands'
      assign p = settings.page_brands
      assign handle = 'marcas'
      assign anchor = '#marcas'
    when 'explore'
      assign p = settings.explore_collection
      assign fallback = routes.all_products_collection_url
    when 'search'
      assign fallback = routes.search_url
  endcase
  assign found = false
  assign url = fallback
  if anchor != blank
    assign url = routes.root_url | append: anchor
  endif
  if p != blank
    assign found = true
    assign url = p.url
  elsif handle != blank
    assign alt = pages[handle]
    if alt != blank
      assign found = true
      assign url = alt.url
    endif
  elsif key == 'explore' or key == 'search'
    assign found = true
  endif
  if out == 'exists'
    echo found
  else
    echo url
  endif
-%}
