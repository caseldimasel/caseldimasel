{%- liquid
  assign s = section.settings
-%}
<section class="sd-section sd-section--alt sd-criteria" id="criterio" data-section-id="{{ section.id }}">
  <div class="sd-container">
    <div class="sd-section-head sd-section-head--split">
      <div>
        {%- if s.eyebrow != blank -%}<p class="sd-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2>{{ s.heading }}</h2>
      </div>
      {%- if s.text != blank -%}<p class="sd-lead">{{ s.text }}</p>{%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="sd-criteria__list" role="list">
        {%- for block in section.blocks -%}
          <li class="sd-criterion" {{ block.shopify_attributes }}>
            <h3 class="sd-criterion__title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p class="sd-criterion__text">{{ block.settings.text }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if s.closing != blank -%}
      <p class="sd-criteria__closing">{{ s.closing }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Criterio de selección",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Nuestro criterio" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Qué buscamos" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "No publicamos todo. Elegimos para cuidar la calidad de lo que ves y para que cada pieza reciba la atención que merece."
    },
    {
      "type": "textarea",
      "id": "closing",
      "label": "Frase final",
      "default": "Una pieza accesible puede tener tanto carácter como una excepcional. Lo que importa es que haya algo que contar."
    }
  ],
  "blocks": [
    {
      "type": "criterion",
      "name": "Criterio",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Historia" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Criterio de selección",
      "blocks": [
        { "type": "criterion", "settings": { "title": "Historia", "text": "Una vida detrás: quién la tuvo, qué ha vivido, por qué importa." } },
        { "type": "criterion", "settings": { "title": "Carácter", "text": "Personalidad propia, que se note al verla y al oírla." } },
        { "type": "criterion", "settings": { "title": "Diseño", "text": "Una forma de resolver las cosas que merece ser mirada." } },
        { "type": "criterion", "settings": { "title": "Singularidad", "text": "Algo que la distingue de otras piezas parecidas." } },
        { "type": "criterion", "settings": { "title": "Cuidado", "text": "Se nota que alguien se ha ocupado de ella." } },
        { "type": "criterion", "settings": { "title": "Procedencia", "text": "Un origen interesante que se pueda contar." } }
      ]
    }
  ]
}
{% endschema %}
