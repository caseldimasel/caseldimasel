<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    <meta name="robots" content="noindex">
    <title>{{ shop.name }}</title>
    {% render 'css-variables' %}
    {{ 'sd-base.css' | asset_url | stylesheet_tag }}
    {{ 'sd-components.css' | asset_url | stylesheet_tag }}
    {{ 'sd-sections.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="sd-body template-password">
    <main id="MainContent" class="sd-main" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
