{%- comment -%}
  Enlace de contacto (WhatsApp, correo o teléfono). Si el canal no está configurado o no es válido,
  no devuelve nada: nunca se genera un enlace con un número o correo de ejemplo.

  Parámetros:
    kind      whatsapp | email | tel
    product   pieza (opcional: añade nombre, referencia y URL canónica al mensaje)
    category  clave de categoría (opcional: usa el contacto de esa categoría si existe)
    sold      true si la pieza está vendida (mensaje «Busco algo parecido»)
    url       URL canónica de la pieza (por defecto: dominio de la tienda + /products/handle)

  Plantillas de mensaje (Ajustes del tema > Sidonia · Contacto) con [nombre], [referencia] y [url].
  El texto se codifica para URL (espacios como %20, saltos de línea como %0D%0A en el correo).
{%- endcomment -%}
{%- liquid
  assign cat = category | downcase | strip
  assign raw = ''
  if kind == 'whatsapp'
    if cat != blank
      capture raw
        render 'sidonia-division', key: cat, out: 'whatsapp'
      endcapture
    else
      assign raw = settings.sidonia_whatsapp
    endif
  elsif kind == 'email'
    if cat != blank
      capture raw
        render 'sidonia-division', key: cat, out: 'email'
      endcapture
    else
      assign raw = settings.sidonia_email
    endif
  else
    assign raw = settings.sidonia_phone
  endif
  assign raw = raw | strip

  assign valid = false
  if kind == 'whatsapp' or kind == 'tel'
    assign digits = raw | replace: '+', '' | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: '.', ''
    if digits.size > 2
      assign first2 = digits | slice: 0, 2
      if first2 == '00'
        assign digits = digits | slice: 2, digits.size
      endif
    endif
    if digits.size >= 8 and digits.size <= 15
      assign valid = true
      assign chars = digits | split: ''
      for ch in chars
        unless '0123456789' contains ch
          assign valid = false
          break
        endunless
      endfor
    endif
  elsif kind == 'email'
    if raw contains '@' and raw contains '.' and raw.size > 5
      unless raw contains ' '
        assign valid = true
      endunless
    endif
  endif

  assign target = ''
  if valid
    if product != blank
      assign p_name = product.title
      assign p_ref = product.metafields.sidonia.reference.value | strip
      if p_ref == blank
        assign p_ref = product.handle
      endif
      if url != blank
        assign p_url = url
      else
        assign p_url = shop.url | append: '/products/' | append: product.handle
      endif
    endif

    if kind == 'whatsapp'
      if product != blank
        if sold
          assign msg = settings.sidonia_msg_whatsapp_sold
        else
          assign msg = settings.sidonia_msg_whatsapp
        endif
        assign msg = msg | replace: '[nombre]', p_name | replace: '[referencia]', p_ref | replace: '[url]', p_url
      else
        assign msg = settings.sidonia_msg_whatsapp_general
      endif
      assign target = 'https://wa.me/' | append: digits
      if msg != blank
        assign enc = msg | url_encode | replace: '+', '%20'
        assign target = target | append: '?text=' | append: enc
      endif
    elsif kind == 'email'
      assign target = 'mailto:' | append: raw
      if product != blank
        if sold
          assign subj = settings.sidonia_msg_email_subject_sold
        else
          assign subj = settings.sidonia_msg_email_subject
        endif
        assign subj = subj | replace: '[nombre]', p_name | replace: '[referencia]', p_ref | replace: '[url]', p_url
        assign body = settings.sidonia_msg_email_body | replace: '[nombre]', p_name | replace: '[referencia]', p_ref | replace: '[url]', p_url
        assign subj_enc = subj | url_encode | replace: '+', '%20'
        assign body_enc = body | url_encode | replace: '+', '%20' | replace: '%0D%0A', '%0A' | replace: '%0A', '%0D%0A'
        assign target = target | append: '?subject=' | append: subj_enc | append: '&body=' | append: body_enc
      endif
    else
      assign target = 'tel:+' | append: digits
    endif
  endif
  echo target
-%}
