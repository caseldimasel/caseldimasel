{%- comment -%}
  SIDONIA · Testimonios y casos. Solo contenido REAL con autorización de uso:
  un testimonio se publica únicamente si su casilla «Autorizado» está marcada y tiene texto.
  Sin testimonios autorizados, la sección no se muestra fuera del editor. Sin puntuaciones ni estrellas.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign visible = 0
  for block in section.blocks
    if block.settings.authorized and block.settings.quote != blank and block.settings.name != blank
      assign visible = visible | plus: 1
    endif
  endfor
-%}
{%- if visible > 0 or request.design_mode -%}
<section class="sidonia-scope sidonia-section sidonia-testimonials{% if s.background == 'surface' %} sidonia-section--surface{% endif %}" data-section-id="{{ section.id }}">
  <div class="sidonia-container">
    <div class="sidonia-head">
      <div class="sidonia-head__text">
        {%- if s.eyebrow != blank -%}<p class="sidonia-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="sidonia-h2">{{ s.heading | escape }}</h2>{%- endif -%}
      </div>
    </div>
    {%- if visible > 0 -%}
      <ul class="sidonia-testimonials__list" role="list">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- if b.authorized and b.quote != blank and b.name != blank -%}
            <li class="sidonia-testimonial" {{ block.shopify_attributes }}>
              <figure>
                <blockquote class="sidonia-testimonial__quote"><p>{{ b.quote | escape }}</p></blockquote>
                <figcaption class="sidonia-testimonial__by">
                  {%- if b.photo != blank and b.photo_authorized -%}
                    {{ b.photo | image_url: width: 160 | image_tag: alt: '', loading: 'lazy', class: 'sidonia-testimonial__photo', width: 56, height: 56 }}
                  {%- endif -%}
                  <span>
                    <span class="sidonia-testimonial__name">{{ b.name | escape }}</span>
                    {%- if b.context != blank -%}<span class="sidonia-testimonial__context">{{ b.context | escape }}</span>{%- endif -%}
                  </span>
                </figcaption>
              </figure>
              {%- if b.product != blank -%}
                <a class="sidonia-link sidonia-testimonial__link" href="{{ b.product.url }}">{{ 'sidonia.testimonials.see_listing' | t }}{%- render 'sidonia-icon', name: 'arrow-right', size: 16 -%}</a>
              {%- endif -%}
            </li>
          {%- elsif request.design_mode -%}
            <li class="sidonia-editor-hint" {{ block.shopify_attributes }}>{{ 'sidonia.editor.testimonial_hidden' | t }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="sidonia-editor-hint">{{ 'sidonia.editor.testimonials_empty' | t }}</p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Sidonia · Testimonios",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "Solo testimonios reales con autorización escrita. No se muestra nada sin la casilla «Autorizado»." },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Testimonios" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Lo que cuentan quienes vendieron con nosotros" },
    { "type": "select", "id": "background", "label": "Fondo", "options": [
      { "value": "bg", "label": "Piedra" },
      { "value": "surface", "label": "Piedra clara" }
    ], "default": "bg" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonio",
      "settings": [
        { "type": "checkbox", "id": "authorized", "label": "Autorizado para publicar", "default": false },
        { "type": "textarea", "id": "quote", "label": "Testimonio (palabras reales)" },
        { "type": "text", "id": "name", "label": "Nombre autorizado" },
        { "type": "text", "id": "context", "label": "Contexto real (opcional)", "info": "Por ejemplo, la pieza que nos confió. Solo hechos reales." },
        { "type": "image_picker", "id": "photo", "label": "Retrato (opcional)" },
        { "type": "checkbox", "id": "photo_authorized", "label": "Retrato autorizado", "default": false },
        { "type": "product", "id": "product", "label": "Pieza relacionada (opcional)" }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [{ "name": "Sidonia · Testimonios" }]
}
{% endschema %}
