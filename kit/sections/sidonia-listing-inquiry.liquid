{%- comment -%}
  SIDONIA · Formulario de consulta de una pieza (formulario de contacto nativo de Shopify).
  - El visitante ve qué pieza consulta (portada, nombre, referencia).
  - Viajan como campos del correo: tipo de consulta, categoría, referencia, nombre de la pieza y URL.
    Son datos del navegador: si un día se integra un servidor, debe resolver la referencia allí.
  - Pieza vendida: «Busco algo parecido» (no se sugiere disponibilidad).
  - El destinatario lo decide Shopify (Ajustes > Notificaciones), no el tema.
  - Sin datos personales en analítica: solo se registra que se envió, con la referencia.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign mf = product.metafields.sidonia
  capture cat
    render 'sidonia-category', product: product
  endcapture
  assign cat = cat | strip
  capture st
    render 'sidonia-status', product: product
  endcapture
  assign st = st | strip
  capture cat_name
    render 'sidonia-division', key: cat, out: 'name'
  endcapture
  assign cat_name = cat_name | strip
  assign ref = mf.reference.value | strip
  if ref == blank
    assign ref = product.handle
  endif
  assign canon = canonical_url | split: '?' | first
  assign is_sold = false
  if st == 'sold'
    assign is_sold = true
  endif
  assign uid = 'sidonia-consulta-' | append: section.id
  if is_sold
    assign kind_label = 'sidonia.inquiry.kind_similar' | t
    assign heading = s.heading_sold
    assign default_msg = 'sidonia.inquiry.message_similar' | t: title: product.title, ref: ref
  else
    assign kind_label = 'sidonia.inquiry.kind_interest' | t
    assign heading = s.heading
    assign default_msg = 'sidonia.inquiry.message_default' | t: title: product.title, ref: ref
  endif
  capture privacy_url
    if settings.sidonia_privacy_page != blank
      echo settings.sidonia_privacy_page.url
    elsif shop.privacy_policy != blank
      echo shop.privacy_policy.url
    endif
  endcapture
  assign privacy_url = privacy_url | strip
  assign id_name = uid | append: '-name'
  assign id_email = uid | append: '-email'
  assign id_phone = uid | append: '-phone'
  assign id_body = uid | append: '-body'
  assign l_name = 'sidonia.forms.name' | t
  assign l_email = 'sidonia.forms.email' | t
  assign l_phone = 'sidonia.forms.phone' | t
  assign l_body = 'sidonia.forms.message' | t
-%}
<section id="sidonia-consulta" class="sidonia-scope sidonia-section sidonia-section--alt sidonia-inquiry" data-section-id="{{ section.id }}">
  <div class="sidonia-container sidonia-inquiry__grid">
    <div class="sidonia-inquiry__intro">
      <h2 class="sidonia-h2">{{ heading | escape }}</h2>
      {%- if s.text != blank -%}<p class="sidonia-lede">{{ s.text | escape }}</p>{%- endif -%}
      <div class="sidonia-inquiry__piece" aria-label="{{ 'sidonia.inquiry.about' | t }}">
        {%- if product.featured_image != blank -%}
          {{ product.featured_image | image_url: width: 240 | image_tag: alt: '', loading: 'lazy', width: 96, height: 72, class: 'sidonia-inquiry__thumb' }}
        {%- endif -%}
        <div>
          <p class="sidonia-note">{{ 'sidonia.inquiry.about' | t }}</p>
          <p class="sidonia-inquiry__title">{{ product.title | escape }}</p>
          <p class="sidonia-note">{% if cat != blank %}{% render 'sidonia-cat-label', key: cat, name: cat_name %} · {% endif %}{{ 'sidonia.listing.reference' | t }} {{ ref | escape }}</p>
        </div>
      </div>
    </div>

    <div class="sidonia-inquiry__form" data-sidonia-form="inquiry">
      {%- form 'contact', id: uid, class: 'sidonia-form' -%}
        {%- render 'sidonia-form-status', form: form, uid: uid, success_title: s.success_title, success_text: s.success_text -%}
        {%- unless form.posted_successfully? -%}
          <input type="hidden" name="contact[Tipo de consulta]" value="{{ kind_label | escape }}">
          <input type="hidden" name="contact[Categoría]" value="{{ cat_name | escape }}">
          <input type="hidden" name="contact[Referencia]" value="{{ ref | escape }}">
          <input type="hidden" name="contact[Pieza]" value="{{ product.title | escape }}">
          <input type="hidden" name="contact[URL de la pieza]" value="{{ canon | escape }}">
          <div class="sidonia-form-grid sidonia-form-grid--2">
            {%- render 'sidonia-field', id: id_name, name: 'contact[name]', label: l_name, required: true, autocomplete: 'name', value: form.name -%}
            {%- render 'sidonia-field', id: id_email, name: 'contact[email]', label: l_email, type: 'email', required: true, autocomplete: 'email', value: form.email -%}
            {%- render 'sidonia-field', id: id_phone, name: 'contact[phone]', label: l_phone, type: 'tel', optional_label: true, autocomplete: 'tel', inputmode: 'tel', value: form.phone -%}
            <fieldset class="sidonia-fieldset sidonia-field">
              <legend>{{ 'sidonia.forms.preferred' | t }}</legend>
              <div class="sidonia-inline-choices">
                <label class="sidonia-choice"><input type="radio" name="contact[Canal preferido]" value="{{ 'sidonia.forms.pref_email' | t }}" checked> {{ 'sidonia.forms.pref_email' | t }}</label>
                <label class="sidonia-choice"><input type="radio" name="contact[Canal preferido]" value="{{ 'sidonia.forms.pref_phone' | t }}"> {{ 'sidonia.forms.pref_phone' | t }}</label>
                <label class="sidonia-choice"><input type="radio" name="contact[Canal preferido]" value="WhatsApp"> WhatsApp</label>
              </div>
            </fieldset>
            {%- assign body_val = form.body | default: default_msg -%}
            {%- render 'sidonia-field', id: id_body, name: 'contact[body]', label: l_body, type: 'textarea', required: true, value: body_val, rows: 5, wide: true -%}
          </div>
          <div class="sidonia-consent">
            <p class="sidonia-note">
              {{ 'sidonia.forms.privacy_text' | t }}
              {%- if privacy_url != blank %} <a href="{{ privacy_url }}">{{ 'sidonia.forms.privacy_link' | t }}</a>.{%- endif -%}
            </p>
          </div>
          <div class="sidonia-form__actions">
            <button type="submit" class="sidonia-btn" data-sidonia-submit>{{ s.button | escape }}</button>
          </div>
        {%- endunless -%}
      {%- endform -%}
    </div>
  </div>
</section>
<script src="{{ 'sidonia-forms.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Sidonia · Consulta",
  "tag": "div",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Me interesa esta pieza" },
    { "type": "text", "id": "heading_sold", "label": "Título si está vendida", "default": "Busco algo parecido" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Escríbenos y te contestamos por el canal que prefieras. La referencia de la pieza viaja con tu mensaje." },
    { "type": "text", "id": "button", "label": "Botón", "default": "Enviar consulta" },
    { "type": "text", "id": "success_title", "label": "Título de envío correcto", "default": "Hemos recibido tu consulta" },
    { "type": "textarea", "id": "success_text", "label": "Texto de envío correcto", "default": "El equipo de Sidonia la revisará y te contestará por el canal que has elegido." }
  ]
}
{% endschema %}
