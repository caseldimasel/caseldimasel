{%- liquid
  assign s = section.settings
  assign story_product = s.product
  assign vkind = ''
  assign vsrc = ''
  assign vid = ''
  assign poster = s.poster
  assign ratio = 0.5625
  assign title_attr = s.heading

  if s.video != blank
    capture vsrc
      render 'video-best-source', video: s.video
    endcapture
    assign vsrc = vsrc | strip
    if vsrc != blank
      assign vkind = 'file'
      if s.video.aspect_ratio != blank
        assign ratio = s.video.aspect_ratio
      endif
      if poster == blank
        assign poster = s.video.preview_image
      endif
    endif
  endif
  if vkind == '' and s.video_url != blank
    assign vkind = s.video_url.type
    assign vid = s.video_url.id
  endif

  assign story_attrs = ''
  if vkind == '' and story_product != blank
    capture story_attrs
      render 'video-attrs', product: story_product
    endcapture
    assign story_attrs = story_attrs | strip
  endif

  capture explore_url
    render 'page-url', key: 'explore'
  endcapture
  capture sell_url
    render 'page-url', key: 'sell'
  endcapture
  assign cta1_url = s.cta1_url | default: explore_url | strip
  assign cta2_url = s.cta2_url | default: sell_url | strip
  assign cta1_label = s.cta1_label | default: settings.label_explore_cta
  assign cta2_label = s.cta2_label
  if cta2_label == blank
    assign cta2_label = 'hero.cta_sell' | t
  endif
  assign video_label = s.video_label | default: settings.label_story_cta
  if cta1_label == blank
    assign cta1_label = 'hero.cta_explore' | t
  endif
  if video_label == blank
    assign video_label = 'hero.cta_video' | t
  endif
  capture cats
    render 'division-keys'
  endcapture
  assign cat_list = cats | strip | split: ','
  assign has_video = false
  if vkind != '' or story_attrs != blank
    assign has_video = true
  endif
-%}

<section class="sd-hero" data-section-id="{{ section.id }}">
  <div class="sd-container sd-hero__grid">
    <div class="sd-hero__copy">
      <p class="sd-eyebrow sd-hero__eyebrow">
        {%- for c in cat_list -%}
          {%- capture c_name -%}{%- render 'division-info', key: c, out: 'name' -%}{%- endcapture -%}
          <span class="sd-cat sd-cat--{{ c }} sd-hero__tag"><span class="sd-nav__dot" aria-hidden="true"></span>{{ c_name | strip }}</span>
        {%- endfor -%}
      </p>
      <h1 class="sd-hero__title">{{ s.heading }}</h1>
      {%- if s.text != blank -%}
        <p class="sd-lead sd-hero__text">{{ s.text }}</p>
      {%- endif -%}

      {%- if s.show_search -%}
        <form class="sd-hero__search" action="{{ routes.search_url }}" method="get" role="search">
          <label class="sd-sr" for="hero-q-{{ section.id }}">{{ 'search.label' | t }}</label>
          <input type="hidden" name="type" value="product">
          <input type="hidden" name="options[prefix]" value="last">
          {%- render 'icon', name: 'search', size: 22 -%}
          <input id="hero-q-{{ section.id }}" class="sd-input" type="search" name="q" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off" enterkeyhint="search">
          <button type="submit" class="sd-btn sd-btn--primary"><span>{{ 'search.submit' | t }}</span></button>
        </form>
      {%- endif -%}

      {%- if s.show_divisions -%}
        <ul class="sd-chiprow sd-hero__divisions" role="list">
          {%- for c in cat_list -%}
            {%- capture c_name -%}{%- render 'division-info', key: c, out: 'name' -%}{%- endcapture -%}
            {%- capture c_url -%}{%- render 'division-info', key: c, out: 'url' -%}{%- endcapture -%}
            <li class="sd-cat sd-cat--{{ c }}"><a class="sd-pill" href="{{ c_url | strip }}"><span class="sd-nav__dot" aria-hidden="true"></span>{{ c_name | strip }}</a></li>
          {%- endfor -%}
          {%- capture brands_url -%}{%- render 'page-url', key: 'brands' -%}{%- endcapture -%}
          <li><a class="sd-pill" href="{{ brands_url | strip }}">{{ 'listing.brands_label' | t }}</a></li>
        </ul>
      {%- endif -%}

      <div class="sd-hero__ctas">
        <a class="sd-btn sd-btn--primary" href="{{ cta1_url }}">
          <span>{{ cta1_label }}</span>{%- render 'icon', name: 'arrow-right', size: 18 -%}
        </a>
        <a class="sd-btn sd-btn--ghost sd-hero__cta2" href="{{ cta2_url }}">{{ cta2_label }}</a>
      </div>
    </div>

    <div class="sd-hero__media">
      <div class="sd-hero__frame{% if poster == blank %} sd-hero__frame--mosaic{% endif %}" style="--sd-vratio: {{ ratio }}">
        {%- if poster != blank -%}
          {%- render 'sd-image', image: poster, widths: '480,640,800,1000,1200', sizes: '(min-width: 1100px) 40vw, 92vw', priority: true, class: 'sd-hero__img', alt: s.poster_alt, cover: true -%}
        {%- else -%}
          <ul class="sd-hero__mosaic" role="list">
            {%- for c in cat_list -%}
              {%- liquid
                capture c_name
                  render 'division-info', key: c, out: 'name'
                endcapture
                capture c_url
                  render 'division-info', key: c, out: 'url'
                endcapture
                assign img_key = 'division_' | append: c | append: '_image'
                assign col_key = 'division_' | append: c | append: '_collection'
                assign tile_img = settings[img_key]
                assign tile_col = settings[col_key]
                if tile_img == blank and tile_col != blank
                  assign tile_img = tile_col.image
                  if tile_img == blank and tile_col.products.size > 0
                    assign tile_img = tile_col.products.first.featured_image
                  endif
                endif
              -%}
              <li class="sd-hero__tile sd-cat sd-cat--{{ c }}">
                {%- if tile_img != blank -%}
                  {%- render 'sd-image', image: tile_img, widths: '320,480,640,800', sizes: '(min-width: 900px) 20vw, 45vw', class: 'sd-hero__tileimg', decorative: true, cover: true, priority: forloop.first -%}
                {%- endif -%}
                <a class="sd-hero__tilename" href="{{ c_url | strip }}"><span class="sd-nav__dot" aria-hidden="true"></span>{{ c_name | strip }}</a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if has_video -%}
          {%- if story_attrs != blank -%}
            <button type="button" class="sd-vplayer__start sd-hero__play" data-sd-play {{ story_attrs }}>
              <span class="sd-play__icon">{%- render 'icon', name: 'play', size: 20 -%}</span>
              <span>{{ video_label }}</span>
            </button>
          {%- else -%}
            <button
              type="button"
              class="sd-vplayer__start sd-hero__play"
              data-sd-play
              data-video-kind="{{ vkind }}"
              {% if vkind == 'file' %}data-video-src="{{ vsrc }}" data-video-mime="video/mp4"{% else %}data-video-id="{{ vid | escape }}"{% endif %}
              {% if poster != blank %}data-video-poster="{{ poster | image_url: width: 900 }}"{% endif %}
              data-video-ratio="{{ ratio }}"
              data-video-title="{{ title_attr | escape }}"
            >
              <span class="sd-play__icon">{%- render 'icon', name: 'play', size: 20 -%}</span>
              <span>{{ video_label }}</span>
            </button>
          {%- endif -%}
        {%- endif -%}
      </div>
      {%- if s.caption != blank -%}
        <p class="sd-hero__caption">{{ s.caption }}</p>
      {%- endif -%}
      {%- if has_video == false and request.design_mode -%}
        <p class="sd-note sd-hero__hint">{{ 'hero.editor_hint' | t }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero con vídeo",
  "tag": "section",
  "class": "sd-section-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titular", "default": "Coches, barcos y casas con alma" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subtítulo",
      "default": "Seleccionamos piezas con carácter y contamos su historia para encontrar a quien sepa apreciarlas."
    },
    { "type": "header", "content": "Botones" },
    { "type": "text", "id": "cta1_label", "label": "Botón principal: texto", "info": "Vacío = Ajustes del tema > Textos de botones." },
    { "type": "url", "id": "cta1_url", "label": "Botón principal: enlace", "info": "Vacío = colección «Explorar»." },
    { "type": "text", "id": "cta2_label", "label": "Botón secundario: texto", "info": "Vacío = «Quiero vender con Sidonia»." },
    { "type": "url", "id": "cta2_url", "label": "Botón secundario: enlace", "info": "Vacío = página «Vender con Sidonia»." },
    { "type": "header", "content": "Vídeo protagonista" },
    {
      "type": "paragraph",
      "content": "Un solo vídeo, con sonido solo tras pulsar el botón. Orden de prioridad: vídeo subido a Shopify, enlace de YouTube o Vimeo, vídeo de la pieza elegida abajo."
    },
    { "type": "video", "id": "video", "label": "Vídeo alojado en Shopify" },
    { "type": "video_url", "id": "video_url", "label": "Enlace de YouTube o Vimeo", "accept": ["youtube", "vimeo"] },
    { "type": "product", "id": "product", "label": "O usar el vídeo y la portada de una pieza" },
    { "type": "text", "id": "video_label", "label": "Texto del control de vídeo", "info": "Vacío = «Ver cómo lo contamos»." },
    { "type": "image_picker", "id": "poster", "label": "Portada", "info": "Se recorta con su punto focal. Sin portada se muestra un mosaico con la imagen de cada división (la portada de Ajustes del tema o la primera pieza de su colección)." },
    { "type": "text", "id": "poster_alt", "label": "Descripción de la portada (accesibilidad)" },
    { "type": "text", "id": "caption", "label": "Pie de la portada (opcional)" },
    { "type": "header", "content": "Acceso inmediato" },
    { "type": "checkbox", "id": "show_search", "label": "Mostrar buscador", "default": true },
    { "type": "checkbox", "id": "show_divisions", "label": "Mostrar accesos a las divisiones", "default": true }
  ],
  "presets": [
    { "name": "Hero con vídeo" }
  ]
}
{% endschema %}
