{%- liquid
  capture keys
    render 'division-keys'
  endcapture
  assign list = keys | strip | split: ','
  assign s = section.settings
-%}
<section class="sd-section sd-divisions" data-section-id="{{ section.id }}">
  <div class="sd-container">
    <div class="sd-section-head sd-section-head--split">
      <div>
        {%- if s.eyebrow != blank -%}<p class="sd-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h2>{{ s.heading }}</h2>
      </div>
      {%- if s.text != blank -%}<p class="sd-lead">{{ s.text }}</p>{%- endif -%}
    </div>

    <ul class="sd-divisions__grid" role="list">
      {%- for c in list -%}
        {%- capture c_name -%}{%- render 'division-info', key: c, out: 'name' -%}{%- endcapture -%}
        {%- capture c_url -%}{%- render 'division-info', key: c, out: 'url' -%}{%- endcapture -%}
        {%- capture c_tag -%}{%- render 'division-info', key: c, out: 'tagline' -%}{%- endcapture -%}
        {%- capture c_count -%}{%- render 'division-info', key: c, out: 'count' -%}{%- endcapture -%}
        {%- assign img_key = 'division_' | append: c | append: '_image' -%}
        {%- assign c_img = settings[img_key] -%}
        {%- assign c_name = c_name | strip -%}
        {%- assign c_count = c_count | strip -%}
        {%- assign c_count_n = c_count | plus: 0 -%}
        <li class="sd-divcard sd-cat sd-cat--{{ c }}">
          <div class="sd-divcard__media">
            {%- liquid
              assign c_cover = c_img
              if c_cover == blank
                assign col_key = 'division_' | append: c | append: '_collection'
                assign c_col = settings[col_key]
                if c_col != blank
                  assign c_cover = c_col.image
                  if c_cover == blank and c_col.products.size > 0
                    assign c_cover = c_col.products.first.featured_image
                  endif
                endif
              endif
            -%}
            {%- if c_cover != blank -%}
              {%- render 'sd-image', image: c_cover, widths: '400,600,800,1000', sizes: '(min-width: 900px) 30vw, 92vw', class: 'sd-divcard__img', decorative: true, cover: true -%}
            {%- elsif c == 'garage' and settings.use_bundled_photos -%}
              {%- render 'bundled-photo', name: 'foto-jaguar-e-type', alt: '', class: 'sd-divcard__img' -%}
            {%- else -%}
              <span class="sd-divcard__fill" aria-hidden="true"><img class="sd-divcard__mark" src="{{ 'sidonia-logo-light.png' | asset_url }}" width="600" height="125" alt="" loading="lazy"></span>
            {%- endif -%}
          </div>
          <div class="sd-divcard__body">
            <h3 class="sd-divcard__name"><a class="sd-divcard__link" href="{{ c_url | strip }}"><span class="sd-nav__dot" aria-hidden="true"></span>{{ c_name }}</a></h3>
            {%- assign c_tag = c_tag | strip -%}
            {%- if c_tag != blank -%}<p class="sd-divcard__tag">{{ c_tag }}</p>{%- endif -%}
            <p class="sd-divcard__foot">
              {%- if settings.show_listing_counts and c_count != blank and c_count_n > 0 -%}
                <span class="sd-divcard__count">{{ 'divisions.count' | t: count: c_count_n }}</span>
              {%- endif -%}
              <span class="sd-divcard__go" aria-hidden="true">{%- render 'icon', name: 'arrow-right', size: 22 -%}</span>
            </p>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Tres mundos",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Explorar por tipo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Coches, barcos y casas" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Tres mundos con un mismo criterio: piezas con historia, de las que se cuentan despacio. Más clásicos que lujo."
    },
    { "type": "paragraph", "content": "Nombres, frases, portadas y colecciones se editan en Ajustes del tema > Divisiones. El número de piezas solo se muestra si la colección está enlazada y tiene contenido." }
  ],
  "presets": [
    { "name": "Tres mundos" }
  ]
}
{% endschema %}
