<section class="sd-section sd-password" data-section-id="{{ section.id }}">
  <div class="sd-container sd-container--narrow">
    <div class="sd-password__brand">{%- render 'logo', variant: 'dark' -%}</div>
    <h1>{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<div class="sd-prose">{{ shop.password_message }}</div>{%- endif -%}
    {%- form 'storefront_password', class: 'sd-form' -%}
      {%- if form.errors -%}
        <div class="sd-notice sd-notice--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="sd-field">
        <label class="sd-label" for="sd-pwd">{{ 'password.label' | t }}</label>
        <input id="sd-pwd" class="sd-input" type="password" name="password" autocomplete="current-password" required>
      </div>
      <button type="submit" class="sd-btn sd-btn--primary">{{ 'password.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Página de contraseña",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Estamos preparando algo" }
  ]
}
{% endschema %}
