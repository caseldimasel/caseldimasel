{%- liquid
  assign s = section.settings
-%}
{%- if section.blocks.size > 0 or request.design_mode -%}
<section class="sd-section sd-team" data-section-id="{{ section.id }}">
  <div class="sd-container">
    <div class="sd-section-head">
      {%- if s.eyebrow != blank -%}<p class="sd-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2>{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="sd-lead">{{ s.text }}</p>{%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="sd-team__grid" role="list">
        {%- for block in section.blocks -%}
          <li class="sd-person" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="sd-person__photo">{%- render 'sd-image', image: block.settings.image, widths: '320,480,640', sizes: '(min-width: 900px) 22vw, 70vw', alt: block.settings.name, cover: true -%}</div>
            {%- endif -%}
            <h3 class="sd-person__name">{{ block.settings.name }}</h3>
            {%- if block.settings.role != blank -%}<p class="sd-person__role">{{ block.settings.role }}</p>{%- endif -%}
            {%- if block.settings.bio != blank -%}<p>{{ block.settings.bio }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div class="sd-empty">
        <h3>{{ 'team.editor_empty_title' | t }}</h3>
        <p>{{ 'team.editor_empty_text' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Equipo",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Las personas" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Quién está detrás" },
    { "type": "textarea", "id": "text", "label": "Texto" }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Persona",
      "settings": [
        { "type": "text", "id": "name", "label": "Nombre" },
        { "type": "text", "id": "role", "label": "Cargo o papel" },
        { "type": "textarea", "id": "bio", "label": "Breve presentación" },
        { "type": "image_picker", "id": "image", "label": "Foto (solo con autorización)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "Equipo" }
  ]
}
{% endschema %}
