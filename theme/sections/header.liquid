{%- liquid
  assign menu = section.settings.menu
  capture sell_url
    if section.settings.cta_url != blank
      echo section.settings.cta_url
    else
      render 'page-url', key: 'sell'
    endif
  endcapture
  capture fav_url
    render 'page-url', key: 'favorites'
  endcapture
  capture explore_url
    render 'page-url', key: 'explore'
  endcapture
  capture how_url
    render 'page-url', key: 'how'
  endcapture
  capture about_url
    render 'page-url', key: 'about'
  endcapture
  capture brands_url
    render 'page-url', key: 'brands'
  endcapture
  assign sell_label = section.settings.cta_label
  if sell_label == blank
    assign sell_label = settings.label_sell_cta
  endif
  if sell_label == blank
    assign sell_label = 'header.sell' | t
  endif
  capture keys
    render 'division-keys'
  endcapture
  assign key_list = keys | strip | split: ','
  assign url_str = ''
  for c in key_list
    capture c_url
      render 'division-info', key: c, out: 'url'
    endcapture
    assign url_str = url_str | append: c_url | strip | append: '|'
  endfor
  assign url_list = url_str | split: '|'
-%}

<sd-header class="sd-header{% if settings.sticky_header %} sd-header--sticky{% endif %}" data-section-id="{{ section.id }}">
  <div class="sd-header__top">
    <div class="sd-header__bar sd-container">
      <a class="sd-header__brand" href="{{ routes.root_url }}" aria-label="{{ settings.brand_name | default: shop.name | escape }}">
        {%- render 'logo', variant: 'dark' -%}
      </a>

      {%- if section.settings.show_search -%}
        <a class="sd-searchbar" href="{{ routes.search_url }}" data-sd-open="search" aria-haspopup="dialog">
          {%- render 'icon', name: 'search', size: 20 -%}
          <span class="sd-searchbar__text">{{ 'header.search_hint' | t }}</span>
          <span class="sd-sr">{{ 'header.search' | t }}</span>
        </a>
      {%- endif -%}

      <div class="sd-header__tools">
        {%- if section.settings.show_search -%}
          <a class="sd-iconbtn sd-header__searchicon" href="{{ routes.search_url }}" data-sd-open="search" aria-haspopup="dialog">
            {%- render 'icon', name: 'search', size: 22 -%}
            <span class="sd-sr">{{ 'header.search' | t }}</span>
          </a>
        {%- endif -%}
        {%- if section.settings.show_favorites -%}
          <a class="sd-iconbtn sd-header__fav" href="{{ fav_url }}" data-sd-fav-link>
            {%- render 'icon', name: 'heart', size: 22 -%}
            <span class="sd-sr" data-sd-fav-label>{{ 'header.favorites' | t }}</span>
            <sd-fav-count class="sd-badge" hidden></sd-fav-count>
          </a>
        {%- endif -%}
        <a class="sd-btn sd-btn--secondary sd-btn--sm sd-header__cta" href="{{ sell_url }}">{{ sell_label }}</a>
        <button type="button" class="sd-iconbtn sd-header__burger" data-sd-open="drawer" aria-haspopup="dialog">
          {%- render 'icon', name: 'menu', size: 24 -%}
          <span class="sd-sr">{{ 'header.open_menu' | t }}</span>
        </button>
      </div>
    </div>
  </div>

  <div class="sd-header__sub">
    <nav class="sd-nav sd-container" aria-label="{{ 'header.primary_nav' | t }}">
      <ul class="sd-nav__list" role="list">
        {%- if menu != blank and menu.links.size > 0 -%}
          {%- for link in menu.links -%}
            {%- assign cat_key = '' -%}
            {%- for c in key_list -%}
              {%- if link.url == url_list[forloop.index0] -%}{%- assign cat_key = c -%}{%- endif -%}
            {%- endfor -%}
            <li class="sd-nav__item{% if cat_key != blank %} sd-cat sd-cat--{{ cat_key }}{% endif %}">
              {%- if link.links.size > 0 -%}
                <details class="sd-nav__more">
                  <summary class="sd-nav__link">{{ link.title | escape }}{% render 'icon', name: 'chevron-down', size: 16 %}</summary>
                  <ul class="sd-nav__sub" role="list">
                    <li><a class="sd-nav__sublink" href="{{ link.url }}">{{ link.title | escape }}</a></li>
                    {%- for child in link.links -%}
                      <li><a class="sd-nav__sublink" href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a class="sd-nav__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                  {%- if cat_key != blank -%}<span class="sd-nav__dot" aria-hidden="true"></span>{%- endif -%}
                  {{ link.title | escape }}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          <li class="sd-nav__item"><a class="sd-nav__link" href="{{ explore_url }}">{{ 'header.explore' | t }}</a></li>
          {%- for c in key_list -%}
            {%- capture c_name -%}{%- render 'division-info', key: c, out: 'name' -%}{%- endcapture -%}
            <li class="sd-nav__item sd-cat sd-cat--{{ c }}"><a class="sd-nav__link" href="{{ url_list[forloop.index0] }}"><span class="sd-nav__dot" aria-hidden="true"></span>{{ c_name | strip }}</a></li>
          {%- endfor -%}
          <li class="sd-nav__item"><a class="sd-nav__link" href="{{ brands_url | strip }}">{{ 'header.brands' | t }}</a></li>
          <li class="sd-nav__item"><a class="sd-nav__link" href="{{ how_url }}">{{ 'header.how' | t }}</a></li>
          <li class="sd-nav__item"><a class="sd-nav__link" href="{{ about_url }}">{{ 'header.about' | t }}</a></li>
        {%- endif -%}
      </ul>
    </nav>
  </div>

  <dialog class="sd-drawer" aria-label="{{ 'header.menu' | t }}">
    <div class="sd-drawer__head">
      <span class="sd-drawer__title">{%- render 'logo', variant: 'dark' -%}</span>
      <button type="button" class="sd-iconbtn" data-sd-close aria-label="{{ 'general.close' | t }}">
        {%- render 'icon', name: 'close', size: 24 -%}
      </button>
    </div>
    <a class="sd-btn sd-btn--primary sd-btn--block sd-drawer__cta" href="{{ sell_url }}">
      <span>{{ sell_label }}</span>{%- render 'icon', name: 'arrow-right', size: 18 -%}
    </a>
    <nav aria-label="{{ 'header.primary_nav' | t }}">
      <ul class="sd-drawer__list" role="list">
        {%- if menu != blank and menu.links.size > 0 -%}
          {%- for link in menu.links -%}
            {%- assign cat_key = '' -%}
            {%- for c in key_list -%}
              {%- if link.url == url_list[forloop.index0] -%}{%- assign cat_key = c -%}{%- endif -%}
            {%- endfor -%}
            <li class="{% if cat_key != blank %}sd-cat sd-cat--{{ cat_key }}{% endif %}">
              <a class="sd-drawer__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                {%- if cat_key != blank -%}<span class="sd-nav__dot" aria-hidden="true"></span>{%- endif -%}
                {{ link.title | escape }}
              </a>
              {%- if link.links.size > 0 -%}
                <ul class="sd-drawer__sub" role="list">
                  {%- for child in link.links -%}
                    <li><a class="sd-drawer__sublink" href="{{ child.url }}">{{ child.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          <li><a class="sd-drawer__link" href="{{ explore_url }}">{{ 'header.explore' | t }}</a></li>
          {%- for c in key_list -%}
            {%- capture c_name -%}{%- render 'division-info', key: c, out: 'name' -%}{%- endcapture -%}
            <li class="sd-cat sd-cat--{{ c }}"><a class="sd-drawer__link" href="{{ url_list[forloop.index0] }}"><span class="sd-nav__dot" aria-hidden="true"></span>{{ c_name | strip }}</a></li>
          {%- endfor -%}
          <li><a class="sd-drawer__link" href="{{ brands_url | strip }}">{{ 'header.brands' | t }}</a></li>
          <li><a class="sd-drawer__link" href="{{ how_url }}">{{ 'header.how' | t }}</a></li>
          <li><a class="sd-drawer__link" href="{{ about_url }}">{{ 'header.about' | t }}</a></li>
        {%- endif -%}
      </ul>
    </nav>
    <div class="sd-drawer__foot">
      <a class="sd-btn sd-btn--secondary sd-btn--block" href="{{ fav_url }}">
        {%- render 'icon', name: 'heart', size: 20 -%}<span>{{ 'header.favorites' | t }}</span>
      </a>
      <a class="sd-btn sd-btn--secondary sd-btn--block" href="{{ routes.search_url }}" data-sd-open="search">
        {%- render 'icon', name: 'search', size: 20 -%}<span>{{ 'header.search' | t }}</span>
      </a>
      <p class="sd-note">{{ 'favorites.local_note' | t }}</p>
    </div>
  </dialog>

  <dialog class="sd-searchdlg" aria-label="{{ 'search.dialog_label' | t }}">
    <div class="sd-searchdlg__inner">
      <div class="sd-searchdlg__head">
        <form class="sd-searchdlg__form" action="{{ routes.search_url }}" method="get" role="search">
          <label class="sd-sr" for="sd-search-{{ section.id }}">{{ 'search.label' | t }}</label>
          <input type="hidden" name="type" value="product">
          <input type="hidden" name="options[prefix]" value="last">
          <input
            id="sd-search-{{ section.id }}"
            class="sd-input sd-searchdlg__input"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'search.placeholder' | t }}"
            autocomplete="off"
            data-sd-suggest-input
            enterkeyhint="search"
          >
          <button type="submit" class="sd-btn sd-btn--primary">{{ 'search.submit' | t }}</button>
        </form>
        <button type="button" class="sd-iconbtn" data-sd-close aria-label="{{ 'general.close' | t }}">
          {%- render 'icon', name: 'close', size: 24 -%}
        </button>
      </div>
      <div class="sd-searchdlg__results" data-sd-suggest-results aria-live="polite"></div>
      <div class="sd-searchdlg__quick">
        <p class="sd-eyebrow">{{ 'search.quick' | t }}</p>
        <ul class="sd-chiprow" role="list">
          {%- render 'division-chips' -%}
          <li><a class="sd-chip sd-chip--cat" href="{{ brands_url | strip }}">{{ 'header.brands' | t }}</a></li>
        </ul>
      </div>
    </div>
  </dialog>
</sd-header>

{% schema %}
{
  "name": "Cabecera",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú de categorías",
      "default": "main-menu",
      "info": "Segunda fila de la cabecera. Si está vacío se usa un menú de reserva: Explorar, divisiones, Marcas, Cómo vendemos y Sobre Sidonia."
    },
    { "type": "text", "id": "cta_label", "label": "Texto del botón de venta", "info": "Si está vacío se usa el de Ajustes del tema > Textos de botones." },
    { "type": "url", "id": "cta_url", "label": "Enlace del botón de venta", "info": "Si está vacío se usa la página «Vender con Sidonia»." },
    { "type": "checkbox", "id": "show_search", "label": "Mostrar buscador", "default": true },
    { "type": "checkbox", "id": "show_favorites", "label": "Mostrar favoritos con contador", "default": true }
  ]
}
{% endschema %}
