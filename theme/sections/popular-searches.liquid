{%- liquid
  assign s = section.settings
-%}
{%- if section.blocks.size > 0 -%}
<section class="sd-section sd-section--tight sd-popular" data-section-id="{{ section.id }}">
  <div class="sd-container">
    <h2 class="sd-popular__title">{{ s.heading }}</h2>
    <ul class="sd-popular__list" role="list">
      {%- for block in section.blocks -%}
        {%- if block.settings.label != blank and block.settings.url != blank -%}
          <li {{ block.shopify_attributes }}><a class="sd-pill" href="{{ block.settings.url }}">{{ block.settings.label | escape }}</a></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Búsquedas populares",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Búsquedas populares" },
    { "type": "paragraph", "content": "Son atajos a listados con filtros. Comprueba que los enlaces llevan a resultados reales." }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Enlace",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto" },
        { "type": "url", "id": "url", "label": "Enlace" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    { "name": "Búsquedas populares", "blocks": [{ "type": "link" }, { "type": "link" }, { "type": "link" }] }
  ]
}
{% endschema %}
