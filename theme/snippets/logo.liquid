{%- comment -%}
  Logo de marca. Parámetros: variant ('dark' = para fondos claros, 'light' = para fondos oscuros), class.
  Si no hay imagen subida se muestra el nombre de la marca como texto.
{%- endcomment -%}
{%- liquid
  if variant == 'light'
    assign img = settings.logo_light | default: settings.logo
  else
    assign img = settings.logo_dark | default: settings.logo
  endif
  assign mark = settings.isotype
  assign w = settings.logo_width | default: 160
  assign brand = settings.brand_name | default: shop.name
-%}
{%- if img != blank -%}
  <span class="sd-logo {{ class }}{% if mark != blank %} sd-logo--has-mark{% endif %}" style="--sd-logo-w: {{ w }}px">
    <img class="sd-logo__img sd-logo__full" src="{{ img | image_url: width: 640 }}" alt="{{ brand | escape }}"{% if img.aspect_ratio %} width="{{ w }}" height="{{ w | divided_by: img.aspect_ratio | round }}"{% endif %}>
    {%- if mark != blank -%}
      <img class="sd-logo__img sd-logo__mark" src="{{ mark | image_url: width: 160 }}" alt="{{ brand | escape }}" width="40" height="40">
    {%- endif -%}
  </span>
{%- else -%}
  <span class="sd-logo sd-logo--text {{ class }}">
    {%- if mark != blank -%}
      <img class="sd-logo__img sd-logo__mark-inline" src="{{ mark | image_url: width: 160 }}" alt="" width="32" height="32">
    {%- endif -%}
    <span class="sd-logo__word">{{ brand }}</span>
  </span>
{%- endif -%}
