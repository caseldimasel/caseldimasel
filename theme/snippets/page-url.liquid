{%- comment -%}
  URL de una página clave del tema.
  Parámetro: key = sell | how | about | favorites | contact | archive | wanted | brands | explore | search
  Se usa la página elegida en Ajustes del tema > Páginas clave; si no hay, la ruta /pages/<handle> de reserva.
{%- endcomment -%}
{%- liquid
  case key
    when 'sell'
      assign p = settings.page_sell
      assign fallback = '/pages/vender'
    when 'how'
      assign p = settings.page_how
      assign fallback = '/pages/como-vendemos'
    when 'about'
      assign p = settings.page_about
      assign fallback = '/pages/sobre-sidonia'
    when 'favorites'
      assign p = settings.page_favorites
      assign fallback = '/pages/favoritos'
    when 'contact'
      assign p = settings.page_contact
      assign fallback = '/pages/contacto'
    when 'archive'
      assign p = settings.page_archive
      assign fallback = '/pages/archivo'
    when 'wanted'
      assign p = settings.page_wanted
      assign fallback = '/pages/busco'
    when 'brands'
      assign p = settings.page_brands
      assign fallback = '/pages/marcas'
    when 'explore'
      assign p = settings.explore_collection
      assign fallback = routes.all_products_collection_url
    when 'search'
      assign p = nil
      assign fallback = routes.search_url
    else
      assign p = nil
      assign fallback = routes.root_url
  endcase
  if p != blank
    echo p.url
  else
    echo fallback
  endif
-%}
