[
  {
    "name": "theme_info",
    "theme_name": "Sidonia",
    "theme_version": "1.0.0",
    "theme_author": "Sidonia",
    "theme_documentation_url": "https://github.com/caseldimasel/caseldimasel",
    "theme_support_url": "https://github.com/caseldimasel/caseldimasel/issues"
  },
  {
    "name": "Marca y logos",
    "settings": [
      {
        "type": "paragraph",
        "content": "Sidonia usa un único logo para la marca madre y para sus divisiones. Si no subes ninguno, el tema muestra la palabra del nombre de marca en texto. Se admiten PNG, JPG, WebP y SVG (súbelos primero en Contenido > Archivos o desde el propio selector)."
      },
      {
        "type": "text",
        "id": "brand_name",
        "label": "Nombre de la marca",
        "default": "SIDONIA"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo principal",
        "info": "Se usa si no hay versión clara u oscura."
      },
      {
        "type": "image_picker",
        "id": "logo_dark",
        "label": "Logo versión oscura",
        "info": "Para fondos claros (cabecera). Tiene prioridad sobre el logo principal en la cabecera."
      },
      {
        "type": "image_picker",
        "id": "logo_light",
        "label": "Logo versión clara",
        "info": "Para fondos oscuros (pie de página y reproductor)."
      },
      {
        "type": "image_picker",
        "id": "isotype",
        "label": "Isotipo",
        "info": "Marca reducida. Se usa en móvil cuando la cabecera va justa y en el pie."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "PNG cuadrado, mínimo 48 × 48 px."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Ancho del logo",
        "min": 80,
        "max": 320,
        "step": 4,
        "unit": "px",
        "default": 160
      },
      {
        "type": "image_picker",
        "id": "og_image",
        "label": "Imagen para compartir por defecto",
        "info": "1200 × 630 px. Se usa en páginas sin imagen propia."
      }
    ]
  },
