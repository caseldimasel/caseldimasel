  {
    "name": "Tipografía",
    "settings": [
      {
        "type": "paragraph",
        "content": "Máximo dos familias: una para títulos y otra para interfaz y datos. Por defecto se usan fuentes del sistema (sin descarga, sin licencias). Puedes cambiar a la biblioteca de fuentes de Shopify, cuyas licencias gestiona Shopify."
      },
      {
        "type": "select",
        "id": "heading_font_mode",
        "label": "Fuente de títulos",
        "options": [
          {
            "value": "system",
            "label": "Serif editorial del sistema"
          },
          {
            "value": "shopify",
            "label": "Biblioteca de Shopify (elige abajo)"
          }
        ],
        "default": "system"
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Fuente de títulos (biblioteca)",
        "default": "assistant_n4"
      },
      {
        "type": "select",
        "id": "body_font_mode",
        "label": "Fuente de interfaz y datos",
        "options": [
          {
            "value": "system",
            "label": "Sans del sistema"
          },
          {
            "value": "shopify",
            "label": "Biblioteca de Shopify (elige abajo)"
          }
        ],
        "default": "system"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Fuente de interfaz (biblioteca)",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Escala de títulos",
        "min": 85,
        "max": 125,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "select",
        "id": "body_size",
        "label": "Tamaño del texto",
        "options": [
          {
            "value": "16",
            "label": "16 px"
          },
          {
            "value": "17",
            "label": "17 px"
          },
          {
            "value": "18",
            "label": "18 px"
          }
        ],
        "default": "17"
      }
    ]
  },
