        "label": "Teléfono (opcional)"
      },
      {
        "type": "text",
        "id": "contact_hours",
        "label": "Horario de atención (opcional)",
        "info": "Se muestra tal cual. No se promete tiempo de respuesta salvo que lo escribas aquí."
      },
      {
        "type": "text",
        "id": "contact_response_note",
        "label": "Nota de respuesta (opcional)",
        "info": "Por ejemplo: «Respondemos en días laborables». Déjala vacía si no quieres prometer plazos."
      },
      {
        "type": "textarea",
        "id": "whatsapp_message",
        "label": "Mensaje de WhatsApp para una pieza",
        "info": "Variables: [nombre], [referencia], [url].",
        "default": "Hola, me interesa [nombre], referencia [referencia]. La he visto aquí: [url]. ¿Podéis darme más información?"
      },
      {
        "type": "textarea",
        "id": "whatsapp_message_sold",
        "label": "Mensaje de WhatsApp para una pieza vendida",
        "info": "Variables: [nombre], [referencia], [url].",
