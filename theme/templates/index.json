    "how": {
      "type": "how-we-sell",
      "settings": {},
      "blocks": {
        "step-1": {
          "type": "step",
          "settings": {
            "title": "Nos cuentas qué tienes",
            "text": "Nos explicas qué es y qué lo hace especial. Cuanto más personal sea la historia, mejor."
          }
        },
        "step-2": {
          "type": "step",
          "settings": {
            "title": "Valoramos si encaja",
            "text": "Miramos si encaja en Sidonia y acordamos contigo cómo trabajar."
          }
        },
        "step-3": {
          "type": "step",
          "settings": {
            "title": "Grabamos y contamos su historia",
            "text": "Vamos a verla, la grabamos y preparamos un vídeo con una narración cuidada."
          }
        },
        "step-4": {
          "type": "step",
          "settings": {
            "title": "La presentamos a nuestra comunidad",
            "text": "La publicamos y atendemos el interés que genere, según el servicio que contrates."
          }
        }
      },
      "block_order": [
        "step-1",
        "step-2",
        "step-3",
