      "type": "selection-criteria",
      "settings": {},
      "blocks": {
        "criterion-1": {
          "type": "criterion",
          "settings": {
            "title": "Historia",
            "text": "Una vida detrás: quién la tuvo, qué ha vivido, por qué importa."
          }
        },
        "criterion-2": {
          "type": "criterion",
          "settings": {
            "title": "Carácter",
            "text": "Personalidad propia, que se note al verla y al oírla."
          }
        },
        "criterion-3": {
          "type": "criterion",
          "settings": {
            "title": "Diseño",
            "text": "Una forma de resolver las cosas que merece ser mirada."
          }
        },
        "criterion-4": {
          "type": "criterion",
          "settings": {
            "title": "Singularidad",
            "text": "Algo que la distingue de otras piezas parecidas."
          }
        },
        "criterion-5": {
          "type": "criterion",
          "settings": {
            "title": "Cuidado",
            "text": "Se nota que alguien se ha ocupado de ella."
          }
        },
        "criterion-6": {
          "type": "criterion",
          "settings": {
            "title": "Procedencia",
            "text": "Un origen interesante que se pueda contar."
          }
        }
      },
