          "type": "item",
          "settings": {
            "icon": "check",
            "title": "Selección con criterio",
            "text": "No publicamos todo: elegimos piezas con historia, carácter y cuidado."
          }
        },
        "item-2": {
          "type": "item",
          "settings": {
            "icon": "camera",
            "title": "Cada pieza, bien contada",
            "text": "Fotos, vídeo y una narración que explica por qué merece la pena."
          }
        },
        "item-3": {
          "type": "item",
          "settings": {
            "icon": "chat",
