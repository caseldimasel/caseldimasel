{
  "rewrites": [
    {
      "source": "/proxy/:ruta*",
      "destination": "/api/proxy?ruta=:ruta*"
    },
    {
      "source": "/tienda/:ruta*",
      "destination": "/api/tienda?ruta=:ruta*"
    },
    {
      "source": "/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/:ruta*",
      "has": [
        {
          "type": "query",
          "key": "signature"
        }
      ],
      "destination": "/api/proxy?ruta=:ruta*"
    },
    {
      "source": "/",
      "destination": "/api/inicio"
    }
  ]
}
